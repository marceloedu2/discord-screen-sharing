# Caddy na frente do app e do servidor: TLS automático, WebSocket sem
# configuração, e o roteamento por caminho que mantém os dois na mesma origem.
#
# Escolhemos Caddy em vez de nginx por causa de duas linhas que no nginx são
# vinte: o certificado do Let's Encrypt, renovado sozinho, e o upgrade do
# WebSocket, que o reverse_proxy repassa sem precisar de bloco de headers.
#
# A lista de caminhos abaixo é a mesma de infra/server-paths.mjs, que a porta de
# entrada de desenvolvimento importa. Caddy não lê JavaScript, então ela está
# repetida aqui — quando nascer uma rota nova, são estes dois lugares.

exemplo.com {
	# O /.proxy* na frente de cada caminho é como a atividade do Discord os
	# entrega; o servidor remove o prefixo do outro lado.
	@server path /ws /.proxy/ws \
		/api/token /.proxy/api/token \
		/api/session* /.proxy/api/session* \
		/api/rooms/* /.proxy/api/rooms/* \
		/api/health /.proxy/api/health \
		/auth/* /.proxy/auth/*
	reverse_proxy @server 127.0.0.1:3101

	# Todo o resto é o app: páginas, /_next/*, /api/avatar/*.
	reverse_proxy 127.0.0.1:3100

	# Não comprima o que vai pelo socket: já é vídeo codificado, e comprimir de
	# novo só gasta CPU. O Caddy não comprime WebSocket, então esta linha
	# alcança só o app — que é justamente quem se beneficia.
	encode zstd gzip

	# Nenhum X-Frame-Options aqui, de propósito: o Discord embute a página num
	# iframe e o navegador obedece a esse header antes de qualquer coisa. O CSP
	# frame-ancestors que autoriza o iframe é posto pelo app, em next.config.ts.
}
