{
  "name": "discord-screen-sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/up.mjs --dev",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run build && node scripts/up.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:create": "node scripts/tunnel-create.mjs",
    "types": "npm run types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/test-frontend.mjs",
    "test:fast": "node scripts/test-frontend.mjs --fast",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run types && npm run lint && npm run test"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "ws": "^8.18.3"
  }
}
