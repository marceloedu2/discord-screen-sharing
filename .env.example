# Modelo do .env. Copie para ".env" e preencha.
#
# Nenhum destes valores é enviado a lugar nenhum além da própria API do
# Discord, que é quem os emite.

# Obrigatório em produção (NODE_ENV=production). Assina os tokens de sessão e
# de sala; qualquer string aleatória e longa serve.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# As três portas. Só a primeira importa para quem usa: é nela que o navegador
# bate, e quem atende ali roteia por caminho entre as outras duas. As outras
# existem porque app e servidor são processos separados — mudá-las só é preciso
# se algo mais na máquina já ocupa esses números.
PORT=3000
APP_PORT=3100
RELAY_PORT=3101

# Endereço público pelo qual o Discord (ou quem você convidar) alcança a porta
# de entrada. Precisa ser https:// fora de localhost.
PUBLIC_ORIGIN=http://localhost:3000

# Credenciais da aplicação em https://discord.com/developers/applications.
# Deixe em branco para rodar só no navegador, sem integração com o Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opcional: token de bot, só para confirmar presença em canal de voz (escopo
# por call). Sem ele o escopo cai para a instância da Activity.
DISCORD_BOT_TOKEN=

NODE_ENV=development
